{
  "name": "@sidequest/app",
  "version": "0.0.1",
  "private": true,
  "description": "App Electron : tray + overlay mascotte",
  "author": "NicolasFradin",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "prestart": "electron-rebuild -f -w better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "predist": "pnpm --filter @sidequest/core build && electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@sidequest/core": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@electron/rebuild": "^3.7.1"
  },
  "build": {
    "appId": "com.sidequest.app",
    "productName": "SideQuest",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!src/**/*.map"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": ["dmg", "zip"],
      "identity": null
    },
    "afterSign": "build/afterSign.cjs",
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
